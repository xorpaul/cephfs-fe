# Sample unit.
# Settings are in /etc/cephfs-fe/config (see config.example).
[Unit]
Description=CephFS index search web frontend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# ProtectHome=yes hides ~/.pgpass, so point pgx at a file under /etc.
Environment=PGPASSFILE=/etc/cephfs-fe/pgpass
ExecStart=/usr/local/bin/cephfs-fe
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# System user owning /etc/cephfs-fe/{tls/key.pem,pgpass} (mode 0600).
User=cephfs-fe
Group=cephfs-fe
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: go-build-release packs binaries with UPX, which
# unpacks into writable+executable memory and gets SIGSEGV under it.
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
